@page "/"
@attribute [Authorize]
@inject MachineRegistry Registry
@inject ScreenshotCache Screenshots
@inject UiLanguage Lang
@implements IDisposable

<h1>@Lang.T("Web.Machines")</h1>

@if (_notice is not null)
{
    <div class="notice @(_noticeOk ? "ok" : "bad")">@_notice</div>
}

@if (_shot is not null)
{
    <section class="card screen">
        <header class="card-head">
            <span class="card-title">@Lang.T("Web.ScreenTitle", _shot.Machine, _shot.App)</span>
            <span class="muted small">@Lang.T("Web.ScreenTakenAt", _shot.TakenAt.ToString("HH:mm:ss"))</span>
            <span class="screen-actions">
                <button class="btn" type="button" disabled="@_capturing"
                        @onclick="() => CaptureAsync(_shot.Machine, _shot.AppId, _shot.App)">@Lang.T("Web.ScreenRefresh")</button>
                <button class="btn" type="button" @onclick="() => _shot = null">@Lang.T("Web.ScreenClose")</button>
            </span>
        </header>
        <img src="@_shot.Url" alt="@_shot.App" width="@_shot.Width" height="@_shot.Height" />
    </section>
}

@foreach (var machine in Registry.Machines)
{
    <section class="card">
        <header class="card-head">
            <span class="presence">
                <span class="dot @(machine.Online ? "online" : "offline")"></span>
                <span class="card-title">@machine.Name</span>
            </span>
            <span class="muted small">@Presence(machine)</span>
            @if (machine.HostName is not null)
            {
                <span class="badge">@machine.HostName</span>
            }
        </header>

        @if (machine.Apps.Count == 0)
        {
            <p class="muted">@Lang.T("Web.NoApps")</p>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>@Lang.T("Web.ColApp")</th>
                        <th>@Lang.T("Web.ColState")</th>
                        <th>@Lang.T("Web.ColLastRun")</th>
                        <th>@Lang.T("Web.ColNextRun")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in machine.Apps)
                    {
                        <tr class="@(app.Enabled ? "" : "disabled")">
                            <td>
                                <div class="app-name">
                                    @app.Name
                                    @if (app.KeepAlive)
                                    {
                                        <span class="badge">@Lang.T("Web.KeepAliveBadge")</span>
                                    }
                                    @if (!app.Enabled)
                                    {
                                        <span class="badge">@Lang.T("Web.DisabledBadge")</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(app.Group))
                                {
                                    <div class="muted small">@app.Group</div>
                                }
                            </td>
                            <td>
                                <span class="state @app.State.ToString().ToLowerInvariant()">@Lang.T("WebState." + app.State)</span>
                                @if (!string.IsNullOrWhiteSpace(app.LastError))
                                {
                                    <div class="error small">@app.LastError</div>
                                }
                            </td>
                            <td>@LastRun(app)</td>
                            <td>@(app.NextRunAt?.ToString("dd/MM HH:mm") ?? "—")</td>
                            <td class="actions">
                                <button class="btn primary" type="button" disabled="@(!machine.Online || _busy)"
                                        @onclick="() => SendAsync(machine.Name, app, RemoteCommandKind.Run)">@Lang.T("Web.Run")</button>
                                <button class="btn" type="button" disabled="@(!machine.Online || _busy)"
                                        @onclick="() => SendAsync(machine.Name, app, RemoteCommandKind.Stop)">@Lang.T("Web.Stop")</button>
                                <button class="btn" type="button" disabled="@(!machine.Online || _busy)"
                                        @onclick="() => SendAsync(machine.Name, app, RemoteCommandKind.Restart)">@Lang.T("Web.Restart")</button>
                                <button class="btn" type="button" disabled="@(!machine.Online || _capturing)"
                                        @onclick="() => CaptureAsync(machine.Name, app.Id, app.Name)">@Lang.T("Web.ViewScreen")</button>
                                <a class="btn" href="@($"/logs/{Uri.EscapeDataString(machine.Name)}/{app.Id}")">@Lang.T("Web.ViewLogs")</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

@code {
    private static readonly TimeSpan CommandTimeout = TimeSpan.FromSeconds(15);

    /// <summary>Chụp và nén ảnh mất lâu hơn một lệnh chạy/dừng, nhất là cửa sổ lớn.</summary>
    private static readonly TimeSpan CaptureTimeout = TimeSpan.FromSeconds(25);

    private string? _notice;
    private bool _noticeOk;
    private bool _busy;
    private bool _capturing;
    private Shot? _shot;

    protected override void OnInitialized() => Registry.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private string Presence(MachineView machine)
    {
        if (machine.Online)
            return Lang.T("Web.Online");

        return machine.LastSeen is { } seen
            ? Lang.T("Web.LastSeen", seen.ToString("dd/MM HH:mm"))
            : Lang.T("Web.NeverConnected");
    }

    /// <summary>Ảnh đang xem. Chỉ giữ một tấm: xem nhiều cửa sổ cùng lúc không phải việc trang này cần làm.</summary>
    private sealed record Shot(
        string Machine, Guid AppId, string App, string Url, int Width, int Height, DateTimeOffset TakenAt);

    private async Task CaptureAsync(string machine, Guid appId, string appName)
    {
        _capturing = true;
        _notice = null;

        try
        {
            var result = await Registry.RequestScreenshotAsync(machine, appId, CaptureTimeout);

            if (!result.Ok)
            {
                _noticeOk = false;
                _notice = Lang.T(result.Failure switch
                {
                    ScreenshotFailure.MachineOffline => "Web.ScreenMachineOffline",
                    ScreenshotFailure.UnknownApp => "Web.ScreenUnknownApp",
                    ScreenshotFailure.NotRunning => "Web.ScreenNotRunning",
                    ScreenshotFailure.NoWindow => "Web.ScreenNoWindow",
                    ScreenshotFailure.Timeout => "Web.ScreenTimeout",
                    _ => "Web.ScreenCaptureFailed",
                });
                return;
            }

            var id = Screenshots.Put(result.Png);
            _shot = new Shot(machine, appId, appName, $"/screenshot/{id}", result.Width, result.Height, result.TakenAt);
        }
        finally
        {
            _capturing = false;
        }
    }

    // Mốc giờ giữ nguyên múi giờ của máy agent, không đổi sang giờ của server.
    private static string LastRun(AppSnapshot app)
        => app.LastRunAt is { } at
            ? at.ToString("dd/MM HH:mm") + (app.LastExitCode is { } code ? $" · {code}" : string.Empty)
            : "—";

    private async Task SendAsync(string machine, AppSnapshot app, RemoteCommandKind kind)
    {
        _busy = true;
        _notice = null;

        try
        {
            var outcome = await Registry.SendAsync(machine, app.Id, kind, CommandTimeout);
            _noticeOk = outcome.Ok;
            _notice = outcome switch
            {
                { Ok: true } => Lang.T("Web.Sent", app.Name, outcome.AgentMessage ?? string.Empty),
                { Failure: CommandFailure.None } => Lang.T("Web.AgentRefused", app.Name, outcome.AgentMessage ?? string.Empty),
                { Failure: CommandFailure.MachineOffline } => Lang.T("Web.MachineOffline"),
                { Failure: CommandFailure.MachineUnknown } => Lang.T("Web.MachineUnknown"),
                { Failure: CommandFailure.Timeout } => Lang.T("Web.Timeout"),
                _ => Lang.T("Web.CommandFailed", outcome.AgentMessage ?? string.Empty),
            };
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose() => Registry.Changed -= OnChanged;
}
