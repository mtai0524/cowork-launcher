@page "/login"
@inject UiLanguage Lang

<div class="login">
    <h1>@Lang.T("Web.Login")</h1>

    @if (Failed)
    {
        <div class="notice bad">@Lang.T("Web.LoginFailed")</div>
    }

    <div class="card">
        <form method="post" action="/auth/login">
            <div class="field">
                <label for="password">@Lang.T("Web.Password")</label>
                <input id="password" name="password" type="password" autofocus autocomplete="current-password" />
            </div>
            <button class="btn primary" type="submit">@Lang.T("Web.Login")</button>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "failed")]
    public string? FailedFlag { get; set; }

    private bool Failed => FailedFlag == "1";
}
