@inherits LayoutComponentBase
@inject UiLanguage Lang
@inject UiTheme Theme
@inject NavigationManager Nav

<div class="shell">
    <header class="topbar">
        <a class="brand" href="/">Cowork Hub</a>

        <AuthorizeView>
            <Authorized>
                <nav class="nav">
                    <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">@Lang.T("Web.NavMachines")</NavLink>
                    <NavLink class="nav-link" href="/agents">@Lang.T("Web.NavAgents")</NavLink>
                </nav>
            </Authorized>
        </AuthorizeView>

        <div class="topbar-right">
            <form class="themes" method="post" action="/ui/theme" aria-label="@Lang.T("Web.Appearance")">
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                @foreach (var theme in UiTheme.Available)
                {
                    <button type="submit" name="theme" value="@theme"
                            aria-pressed="@(theme == Theme.Current ? "true" : "false")">
                        @Lang.T("Theme." + theme)
                    </button>
                }
            </form>

            <form method="post" action="/ui/language">
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                <button class="btn" type="submit" name="language" value="@Lang.Other">
                    @Lang.T("Web.SwitchLanguage")
                </button>
            </form>

            <AuthorizeView>
                <Authorized>
                    <form method="post" action="/auth/logout">
                        <button class="btn" type="submit">@Lang.T("Web.Logout")</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>

    <main class="content">
        @Body
    </main>
</div>

@code {
    /// <summary>Đổi ngôn ngữ hay phong cách xong phải quay lại đúng trang đang xem, không văng về trang chủ.</summary>
    private string ReturnUrl => "/" + Nav.ToBaseRelativePath(Nav.Uri);
}
