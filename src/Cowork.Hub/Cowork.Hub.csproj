<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Hub trung tâm: nhận kết nối từ các agent, hiện trạng thái trên web, chuyển lệnh Chạy/Dừng.
    Cố ý mỏng — mọi logic sổ máy và hợp đồng dữ liệu nằm ở Cowork.Remote để test được.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Cowork.Hub</RootNamespace>
    <AssemblyName>Cowork.Hub</AssemblyName>
    <Product>Cowork Hub</Product>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cowork.Remote\Cowork.Remote.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cowork.Tests" />
  </ItemGroup>

</Project>
