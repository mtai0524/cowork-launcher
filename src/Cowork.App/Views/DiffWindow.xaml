<Window x:Class="Cowork.App.Views.DiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Cowork.App.Localization"
        Title="{Binding Title}"
        Height="640" Width="960" MinHeight="360" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- Nền theo loại dòng đi qua DataTrigger + DynamicResource, không qua converter:
             converter trả về một brush cố định nên đổi chủ đề sẽ không cập nhật lại. -->
        <Style x:Key="DiffRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Added">
                    <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Removed">
                    <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DiffMarker" TargetType="TextBlock">
            <Setter Property="Text" Value=" " />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="14" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Added">
                    <Setter Property="Text" Value="+" />
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Removed">
                    <Setter Property="Text" Value="−" />
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0">
                    <Run Text="−" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" />
                    <Run Text="{Binding LeftLabel, Mode=OneWay}" />
                    <Run Text="   " />
                    <Run Text="+" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" />
                    <Run Text="{Binding RightLabel, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <CheckBox Content="{loc:Tr Diff.OnlyChanges}" IsChecked="{Binding OnlyChanges}"
                      VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Tr Diff.Restore}" Style="{StaticResource DangerButton}"
                        Command="{Binding RestoreCommand}" Click="OnRestoreClick"
                        Visibility="{Binding CanRestore, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{loc:Tr Diff.Close}" Style="{StaticResource PrimaryButton}"
                        Margin="0" MinWidth="90" IsCancel="True" Click="OnCloseClick" />
            </StackPanel>
        </DockPanel>

        <Border Background="{DynamicResource CodeBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <ListBox ItemsSource="{Binding Lines}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DiffRow}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding LeftNumber}" Width="46" TextAlignment="Right"
                                           Foreground="{DynamicResource SubtleBrush}"
                                           FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" />
                                <TextBlock Text="{Binding RightNumber}" Width="46" TextAlignment="Right"
                                           Margin="0,0,10,0"
                                           Foreground="{DynamicResource SubtleBrush}"
                                           FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" />
                                <TextBlock Style="{StaticResource DiffMarker}" />
                                <TextBlock Text="{Binding Text}" Foreground="{DynamicResource OutputTextBrush}"
                                           FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
