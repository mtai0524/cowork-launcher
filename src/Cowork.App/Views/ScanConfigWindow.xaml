<Window x:Class="Cowork.App.Views.ScanConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Cowork.App.Localization"
        Title="{loc:Tr Scan.ConfigTitle}"
        Height="640" Width="960" MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- Chip mức tin cậy: so theo enum chứ không theo nhãn đã dịch,
             nếu không thì đổi ngôn ngữ là mất màu. -->
        <Style x:Key="ConfidenceChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource ChipLowBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Confidence}" Value="High">
                    <Setter Property="Background" Value="{DynamicResource ChipHighBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Confidence}" Value="Medium">
                    <Setter Property="Background" Value="{DynamicResource ChipMediumBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- === Thư mục và tuỳ chọn quét === -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{loc:Tr Scan.FolderLabel}" Style="{StaticResource LabelText}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding RootDirectory, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                        <Button Content="{loc:Tr Common.BrowseFolder}" Click="OnBrowseClick" />
                        <Button Content="{loc:Tr Common.Scan}" Style="{StaticResource PrimaryButton}" Margin="0"
                                Command="{Binding ScanCommand}" MinWidth="80" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <CheckBox Content="{loc:Tr Scan.IncludeLow}"
                              IsChecked="{Binding IncludeLowConfidence}" Margin="0,0,20,0"
                              ToolTip="{loc:Tr Scan.IncludeLowConfigTip}" />
                    <TextBlock Text="{loc:Tr Scan.MaxDepth}" Foreground="{DynamicResource MutedBrush}"
                               Margin="0,0,8,0" />
                    <TextBox Text="{Binding MaxDepth, UpdateSourceTrigger=LostFocus}" Width="56" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- === Thông báo === -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}" />
            <Border Style="{StaticResource ErrorCard}" Margin="0,8,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>
        </StackPanel>

        <!-- === Bảng kết quả === -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0" Padding="1">
            <DataGrid ItemsSource="{Binding Candidates}" BorderThickness="0"
                      CanUserSortColumns="True" RowHeight="46">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="40" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" Margin="0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{loc:Tr Scan.ColPath}" Width="3*" SortMemberPath="RelativePath">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FolderLabel}" FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{loc:Tr Scan.ColConfidence}" Width="90"
                                            SortMemberPath="Confidence">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ConfidenceChip}">
                                    <TextBlock Text="{Binding ConfidenceLabel}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="{loc:Tr Scan.ColFormat}" Width="100" IsReadOnly="True"
                                        Binding="{Binding FormatLabel}" />
                    <DataGridTextColumn Header="{loc:Tr Scan.ColSize}" Width="70" IsReadOnly="True"
                                        Binding="{Binding SizeLabel}" />
                    <DataGridTextColumn Header="{loc:Tr Scan.ColReason}" Width="2*" IsReadOnly="True"
                                        Binding="{Binding Reason}" />
                </DataGrid.Columns>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="ToolTip" Value="{Binding FullPath}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSyntaxProblem}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RowWarningBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>

        <!-- === Nút hành động === -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{loc:Tr Common.Cancel}" Click="OnCancelClick" MinWidth="90" />
                <Button Style="{StaticResource PrimaryButton}" Click="OnAddClick" Margin="0" MinWidth="170"
                        IsEnabled="{Binding HasResults}">
                    <TextBlock>
                        <Run Text="{loc:Tr Scan.AddPrefix}" />
                        <Run Text="{Binding SelectedCount, Mode=OneWay}" />
                        <Run Text="{loc:Tr Scan.AddSuffix}" />
                    </TextBlock>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Button Content="{loc:Tr Scan.SelectHigh}" Command="{Binding SelectHighConfidenceCommand}" />
                <Button Content="{loc:Tr Scan.SelectAll}" Command="{Binding SelectAllCommand}" />
                <Button Content="{loc:Tr Scan.ClearSelection}" Command="{Binding ClearSelectionCommand}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
