<Window x:Class="Cowork.App.Views.ScanProgramWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Cowork.App.Localization"
        Title="{loc:Tr Scan.ProgramTitle}"
        Height="620" Width="940" MinHeight="460" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="ConfidenceChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource ChipLowBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Confidence}" Value="High">
                    <Setter Property="Background" Value="{DynamicResource ChipHighBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Confidence}" Value="Medium">
                    <Setter Property="Background" Value="{DynamicResource ChipMediumBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- === Thư mục và tuỳ chọn === -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{loc:Tr Scan.FolderLabel}" Style="{StaticResource LabelText}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding RootDirectory, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                        <Button Content="{loc:Tr Common.BrowseFolder}" Click="OnBrowseClick" />
                        <Button Content="{loc:Tr Common.Scan}" Style="{StaticResource PrimaryButton}" Margin="0"
                                Command="{Binding ScanCommand}" MinWidth="80" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <CheckBox Content="{loc:Tr Scan.IncludeLow}"
                              IsChecked="{Binding IncludeLowConfidence}" Margin="0,0,20,0"
                              ToolTip="{loc:Tr Scan.IncludeLowProgramTip}" />
                    <TextBlock Text="{loc:Tr Scan.MaxDepth}" Foreground="{DynamicResource MutedBrush}"
                               Margin="0,0,8,0" />
                    <TextBox Text="{Binding MaxDepth, UpdateSourceTrigger=LostFocus}" Width="56" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- === Thông báo === -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}" />
            <Border Style="{StaticResource ErrorCard}" Margin="0,8,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>
        </StackPanel>

        <!-- === Bảng kết quả === -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0" Padding="1">
            <DataGrid ItemsSource="{Binding Candidates}"
                      SelectedItem="{Binding SelectedCandidate}"
                      SelectionMode="Single" IsReadOnly="True" BorderThickness="0"
                      CanUserSortColumns="True" RowHeight="46"
                      MouseDoubleClick="OnRowDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{loc:Tr Scan.ColPath}" Width="3*" SortMemberPath="RelativePath">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FolderLabel}" FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{loc:Tr Scan.ColConfidence}" Width="90"
                                            SortMemberPath="Confidence">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ConfidenceChip}">
                                    <TextBlock Text="{Binding ConfidenceLabel}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="{loc:Tr Scan.ColKind}" Width="110" Binding="{Binding KindLabel}" />
                    <DataGridTextColumn Header="{loc:Tr Scan.ColSize}" Width="80" Binding="{Binding SizeLabel}" />
                    <DataGridTextColumn Header="{loc:Tr Scan.ColReason}" Width="2*" Binding="{Binding Reason}" />
                </DataGrid.Columns>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="ToolTip" Value="{Binding FullPath}" />
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>

        <!-- === Xem trước lệnh sẽ được điền === -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6"
                Padding="12" Margin="0,12,0,0"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{loc:Tr Scan.CommandPreview}" Style="{StaticResource LabelText}"
                           Margin="0,0,0,6" />
                <TextBlock Text="{Binding CommandPreview}" TextWrapping="Wrap"
                           FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" />
                <TextBlock Style="{StaticResource HintText}"
                           Text="{loc:Tr Scan.PowerShellHint}"
                           Visibility="{Binding IsPowerShellSelected,
                               Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- === Nút hành động === -->
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{loc:Tr Common.Cancel}" Click="OnCancelClick" MinWidth="90" />
                <Button Content="{loc:Tr Scan.UseProgram}" Style="{StaticResource PrimaryButton}"
                        Click="OnAcceptClick" Margin="0" MinWidth="190"
                        IsEnabled="{Binding HasSelection}" />
            </StackPanel>
            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12"
                       Text="{loc:Tr Scan.DoubleClickHint}" />
        </DockPanel>
    </Grid>
</Window>
