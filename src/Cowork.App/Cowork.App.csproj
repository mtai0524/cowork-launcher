<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Cowork</AssemblyName>
    <RootNamespace>Cowork.App</RootNamespace>
    <ApplicationIcon>Assets\cowork.ico</ApplicationIcon>
    <Description>Quản lý và chạy các ứng dụng hằng ngày</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\cowork.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cowork.Core\Cowork.Core.csproj" />
    <ProjectReference Include="..\Cowork.Remote\Cowork.Remote.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

</Project>
