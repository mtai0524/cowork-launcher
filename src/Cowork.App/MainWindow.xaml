<Window x:Class="Cowork.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:loc="clr-namespace:Cowork.App.Localization"
        Title="{loc:Tr Main.Title}"
        Height="820" Width="1320" MinHeight="620" MinWidth="1060"
        Icon="Assets/cowork.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI" FontSize="13"
        Closing="OnWindowClosing" StateChanged="OnWindowStateChanged">

    <Window.Resources>
        <!-- Màu trạng thái đi qua DataTrigger + DynamicResource chứ không qua converter:
             converter trả về một brush cố định, đổi chủ đề sẽ không cập nhật lại. -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource StateIdleBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RuntimeState}" Value="Running">
                    <Setter Property="Fill" Value="{DynamicResource StateRunningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RuntimeState}" Value="Starting">
                    <Setter Property="Fill" Value="{DynamicResource StateStartingBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RuntimeState}" Value="Stopping">
                    <Setter Property="Fill" Value="{DynamicResource StateStartingBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RuntimeState}" Value="Failed">
                    <Setter Property="Fill" Value="{DynamicResource StateFailedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RuntimeState}" Value="WaitingRestart">
                    <Setter Property="Fill" Value="{DynamicResource StateStartingBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OutputLineText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OutputTextBrush}" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource OutputErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OutcomeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StateIdleBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Outcome}" Value="Succeeded">
                    <Setter Property="Foreground" Value="{DynamicResource StateRunningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="Running">
                    <Setter Property="Foreground" Value="{DynamicResource StateStartingBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource StateFailedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="NotStarted">
                    <Setter Property="Foreground" Value="{DynamicResource StateFailedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="TimedOut">
                    <Setter Property="Foreground" Value="{DynamicResource StateFailedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="Unhealthy">
                    <Setter Property="Foreground" Value="{DynamicResource StateFailedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- === Thanh công cụ === -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{loc:Tr Main.Brand}" FontSize="17" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,20,0" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox Content="{loc:Tr Main.SchedulerToggle}" IsChecked="{Binding SchedulerEnabled}"
                              Margin="0,0,14,0" ToolTip="{loc:Tr Main.SchedulerToggleTip}" />
                    <Button Content="{loc:Tr Main.Save}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveWorkspaceCommand}" Margin="0" MinWidth="72"
                            ToolTip="{loc:Tr Main.SaveTip}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Content="{loc:Tr Main.Run}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding RunSelectedCommand}" ToolTip="{loc:Tr Main.RunTip}" />
                    <Button Content="{loc:Tr Main.Stop}" Command="{Binding StopSelectedCommand}"
                            ToolTip="{loc:Tr Main.StopTip}" />
                    <Button Content="{loc:Tr Main.Restart}" Command="{Binding RestartSelectedCommand}"
                            ToolTip="{loc:Tr Main.RestartTip}" />
                    <Border Width="1" Margin="6,4" Background="{DynamicResource BorderBrush}" />
                    <Button Content="{loc:Tr Main.RunAll}" Command="{Binding RunAllCommand}"
                            ToolTip="{loc:Tr Main.RunAllTip}" />
                    <Button Content="{loc:Tr Main.StopAll}" Command="{Binding StopAllCommand}" />
                    <Button Content="{loc:Tr Main.CheckSchedule}" Command="{Binding CheckScheduleNowCommand}"
                            ToolTip="{loc:Tr Main.CheckScheduleTip}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- === Nội dung === -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="520" />
            </Grid.ColumnDefinitions>

            <!-- Cột trái: danh sách app -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:Tr AppList.Title}"
                               Style="{StaticResource HeadingText}" />

                    <TextBox DockPanel.Dock="Top" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,8" ToolTip="{loc:Tr AppList.SearchTip}" />

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{loc:Tr AppList.Add}" Command="{Binding AddAppCommand}" Padding="10,5" />
                        <Button Content="{loc:Tr AppList.Duplicate}" Command="{Binding DuplicateAppCommand}"
                                Padding="10,5" />
                        <Button Content="{loc:Tr AppList.Delete}" Command="{Binding DeleteAppCommand}"
                                Style="{StaticResource DangerButton}" Padding="10,5" />
                        <Button Content="↑" Command="{Binding MoveUpCommand}" Padding="8,5" MinWidth="30"
                                ToolTip="{loc:Tr AppList.MoveUpTip}" />
                        <Button Content="↓" Command="{Binding MoveDownCommand}" Padding="8,5" MinWidth="30"
                                Margin="0" ToolTip="{loc:Tr AppList.MoveDownTip}" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding AppsView}" SelectedItem="{Binding SelectedApp}"
                             ItemContainerStyle="{StaticResource AppListItem}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,0,10,0"
                                             VerticalAlignment="Top"
                                             Style="{StaticResource StatusDot}"
                                             ToolTip="{Binding StatusText}" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{loc:Tr AppList.NextRunPrefix}" />
                                            <Run Text="{Binding NextRunText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="⏸" FontSize="12" VerticalAlignment="Top"
                                               Foreground="{DynamicResource MutedBrush}"
                                               ToolTip="{loc:Tr AppList.DisabledTip}"
                                               Visibility="{Binding IsEnabled,
                                                   Converter={StaticResource BoolToVisibility},
                                                   ConverterParameter=invert}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                          Background="Transparent" />

            <!-- Cột phải: chi tiết -->
            <TabControl Grid.Column="2">

                <!-- === Tổng quan === -->
                <TabItem Header="{loc:Tr Tab.Overview}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,0,12,0">
                            <TextBlock Text="{loc:Tr Overview.Empty}" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="Margin" Value="0,20" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedApp}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel DataContext="{Binding SelectedApp}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr Overview.InfoCard}"
                                                   Style="{StaticResource HeadingText}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Tr Overview.Name}"
                                                           Style="{StaticResource LabelText}" />
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{loc:Tr Overview.Group}"
                                                           Style="{StaticResource LabelText}" />
                                                <TextBox Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="{loc:Tr Overview.GroupTip}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{loc:Tr Overview.Description}"
                                                   Style="{StaticResource LabelText}" Margin="0,12,0,4" />
                                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" MinHeight="52" TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top" />

                                        <CheckBox Content="{loc:Tr Overview.EnabledCheck}"
                                                  IsChecked="{Binding IsEnabled}" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr Overview.CommandCard}"
                                                   Style="{StaticResource HeadingText}" />

                                        <TextBlock Text="{loc:Tr Overview.Executable}"
                                                   Style="{StaticResource LabelText}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                                <Button Content="{loc:Tr Common.Browse}"
                                                        Command="{Binding DataContext.BrowseExecutableCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                        ToolTip="{loc:Tr Overview.PickFileTip}" />
                                                <Button Content="{loc:Tr Overview.ScanFolder}" Margin="0"
                                                        Command="{Binding DataContext.ScanProgramFolderCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                        ToolTip="{loc:Tr Overview.ScanProgramTip}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{loc:Tr Overview.Arguments}"
                                                   Style="{StaticResource LabelText}" Margin="0,12,0,4" />
                                        <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Cascadia Mono, Consolas, monospace" />
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="{loc:Tr Overview.ArgumentsHint}" />

                                        <TextBlock Text="{loc:Tr Overview.WorkingDir}"
                                                   Style="{StaticResource LabelText}" Margin="0,12,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="1" Content="{loc:Tr Common.Browse}" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.BrowseWorkingDirectoryCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="{loc:Tr Overview.WorkingDirHint}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr Overview.RunOptionsCard}"
                                                   Style="{StaticResource HeadingText}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <CheckBox Content="{loc:Tr Overview.SingleInstance}"
                                                          IsChecked="{Binding SingleInstance}" />
                                                <CheckBox Content="{loc:Tr Overview.CaptureOutput}"
                                                          IsChecked="{Binding CaptureOutput}" />
                                                <CheckBox Content="{loc:Tr Overview.RunAsAdmin}"
                                                          IsChecked="{Binding RunAsAdministrator}"
                                                          ToolTip="{loc:Tr Overview.RunAsAdminTip}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{loc:Tr Overview.WindowStyle}"
                                                           Style="{StaticResource LabelText}" />
                                                <ComboBox ItemsSource="{Binding WindowStyleOptions}"
                                                          SelectedItem="{Binding SelectedWindowStyle}"
                                                          DisplayMemberPath="Label" />
                                                <TextBlock Text="{loc:Tr Overview.Timeout}"
                                                           Style="{StaticResource LabelText}" Margin="0,12,0,4" />
                                                <TextBox Text="{Binding TimeoutMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Tr Overview.SuccessExitCodes}"
                                                           Style="{StaticResource LabelText}" />
                                                <TextBox Text="{Binding SuccessExitCodesText, UpdateSourceTrigger=LostFocus}"
                                                         FontFamily="Cascadia Mono, Consolas, monospace" />
                                                <TextBlock Style="{StaticResource HintText}"
                                                           Text="{loc:Tr Overview.SuccessExitCodesHint}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{loc:Tr Overview.StopGrace}"
                                                           Style="{StaticResource LabelText}" />
                                                <TextBox Text="{Binding StopGraceSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Style="{StaticResource HintText}"
                                                           Text="{loc:Tr Overview.StopGraceHint}" />
                                            </StackPanel>
                                        </Grid>

                                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                                                Margin="0,14,0,0" Padding="0,12,0,0">
                                            <StackPanel>
                                                <CheckBox Content="{loc:Tr Overview.KeepAlive}" IsChecked="{Binding KeepAlive}" />
                                                <TextBlock Style="{StaticResource HintText}"
                                                           Text="{loc:Tr Overview.KeepAliveHint}" />

                                                <Grid Margin="0,10,0,0" IsEnabled="{Binding KeepAlive}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{loc:Tr Overview.RestartDelay}"
                                                                   Style="{StaticResource LabelText}" />
                                                        <TextBox Text="{Binding RestartDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{loc:Tr Overview.RestartLimit}"
                                                                   Style="{StaticResource LabelText}" />
                                                        <TextBox Text="{Binding MaxRestartsPerHour, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBlock Style="{StaticResource HintText}"
                                                                   Text="{loc:Tr Overview.RestartLimitHint}" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                                                Margin="0,14,0,0" Padding="0,12,0,0"
                                                IsEnabled="{Binding RetryAvailable}">
                                            <StackPanel>
                                                <TextBlock Text="{loc:Tr Overview.RetryTitle}"
                                                           Style="{StaticResource LabelText}" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{loc:Tr Overview.RetryCount}"
                                                                   Style="{StaticResource LabelText}" />
                                                        <TextBox Text="{Binding RetryCount, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{loc:Tr Overview.RetryDelay}"
                                                                   Style="{StaticResource LabelText}" />
                                                        <TextBox Text="{Binding RetryDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Style="{StaticResource HintText}"
                                                           Text="{loc:Tr Overview.RetryHint}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr Overview.HealthCard}"
                                                   Style="{StaticResource HeadingText}" />
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="{loc:Tr Overview.HealthHint}" />

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="2*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Tr Overview.HealthProbe}"
                                                           Style="{StaticResource LabelText}" />
                                                <ComboBox ItemsSource="{Binding HealthProbeOptions}"
                                                          SelectedItem="{Binding SelectedHealthProbe}"
                                                          DisplayMemberPath="Label" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" IsEnabled="{Binding HasHealthProbe}">
                                                <TextBlock Text="{loc:Tr Overview.HealthTarget}"
                                                           Style="{StaticResource LabelText}" />
                                                <TextBox Text="{Binding HealthTarget, UpdateSourceTrigger=LostFocus}"
                                                         FontFamily="Cascadia Mono, Consolas, monospace" />
                                                <TextBlock Style="{StaticResource HintText}"
                                                           Text="{loc:Tr Overview.HealthTargetHint}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Tr Overview.HealthInterval}"
                                                           Style="{StaticResource LabelText}" TextWrapping="Wrap" />
                                                <TextBox Text="{Binding HealthIntervalSeconds, UpdateSourceTrigger=LostFocus}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" IsEnabled="{Binding HasHealthProbe}">
                                                <TextBlock Text="{loc:Tr Overview.HealthTimeout}"
                                                           Style="{StaticResource LabelText}" TextWrapping="Wrap" />
                                                <TextBox Text="{Binding HealthTimeoutSeconds, UpdateSourceTrigger=LostFocus}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" IsEnabled="{Binding HasHealthProbe}">
                                                <TextBlock Text="{loc:Tr Overview.HealthThreshold}"
                                                           Style="{StaticResource LabelText}" TextWrapping="Wrap" />
                                                <TextBox Text="{Binding HealthFailureThreshold, UpdateSourceTrigger=LostFocus}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="6">
                                                <TextBlock Text="{loc:Tr Overview.HealthStartupGrace}"
                                                           Style="{StaticResource LabelText}" TextWrapping="Wrap" />
                                                <TextBox Text="{Binding HealthStartupGraceSeconds, UpdateSourceTrigger=LostFocus}" />
                                            </StackPanel>
                                        </Grid>

                                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                                                Margin="0,14,0,0" Padding="0,12,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{loc:Tr Overview.HealthOutputTitle}"
                                                           Style="{StaticResource LabelText}" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="2*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{loc:Tr Overview.HealthSilence}"
                                                                   Style="{StaticResource LabelText}" TextWrapping="Wrap" />
                                                        <TextBox Text="{Binding HealthSilenceMinutes, UpdateSourceTrigger=LostFocus}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{loc:Tr Overview.HealthPatterns}"
                                                                   Style="{StaticResource LabelText}" TextWrapping="Wrap" />
                                                        <TextBox Text="{Binding HealthFailurePatternsText, UpdateSourceTrigger=LostFocus}"
                                                                 AcceptsReturn="True" MinHeight="52"
                                                                 VerticalContentAlignment="Top"
                                                                 FontFamily="Cascadia Mono, Consolas, monospace" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Style="{StaticResource HintText}"
                                                           Text="{loc:Tr Overview.HealthOutputHint}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr Overview.DependsOnCard}"
                                                   Style="{StaticResource HeadingText}" />
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="{loc:Tr Overview.DependsOnHint}" />

                                        <TextBlock Text="{loc:Tr Overview.DependsOnEmpty}"
                                                   Style="{StaticResource HintText}" Margin="0,10,0,0"
                                                   Visibility="{Binding HasDependencyOptions,
                                                       Converter={StaticResource BoolToVisibility},
                                                       ConverterParameter=invert}" />

                                        <ItemsControl ItemsSource="{Binding DependencyOptions}" Margin="0,10,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="200" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" Content="{Binding DisplayName}"
                                                                  IsChecked="{Binding IsSelected}"
                                                                  VerticalAlignment="Center" />
                                                        <ComboBox Grid.Column="2" ItemsSource="{Binding WaitOptions}"
                                                                  SelectedItem="{Binding SelectedWait}"
                                                                  DisplayMemberPath="Label"
                                                                  IsEnabled="{Binding IsSelected}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="{loc:Tr Overview.DependsOnWaitHint}"
                                                   Visibility="{Binding HasDependencyOptions,
                                                       Converter={StaticResource BoolToVisibility}}" />

                                        <Border Style="{StaticResource ErrorCard}" Margin="0,10,0,0"
                                                Visibility="{Binding DependencyWarning,
                                                    Converter={StaticResource StringToVisibility}}">
                                            <TextBlock Text="{Binding DependencyWarning}"
                                                       Style="{StaticResource ErrorText}" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr Overview.StatusCard}"
                                                   Style="{StaticResource HeadingText}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Overview.StatusLabel}"
                                                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,4" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusText}"
                                                       Margin="0,0,0,4" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr Overview.LastRunLabel}"
                                                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,4" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastRunText}"
                                                       Margin="0,0,0,4" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr Overview.ScheduleLabel}"
                                                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,0" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ScheduleSummary}" />
                                        </Grid>

                                        <Border Style="{StaticResource ErrorCard}" Margin="0,12,0,0"
                                                Visibility="{Binding LastError, Converter={StaticResource StringToVisibility}}">
                                            <TextBlock Text="{Binding LastError}" Style="{StaticResource ErrorText}" />
                                        </Border>

                                        <Button Content="{loc:Tr Overview.OpenAppFolder}" Margin="0,12,0,0"
                                                HorizontalAlignment="Left"
                                                Command="{Binding DataContext.OpenAppFolderCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- === Biến môi trường === -->
                <TabItem Header="{loc:Tr Tab.Environment}">
                    <Border Style="{StaticResource Card}" DataContext="{Binding SelectedApp}" Margin="4,0,12,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Env.Title}"
                                       Style="{StaticResource HeadingText}" />
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource HintText}" Margin="0,0,0,10"
                                       Text="{loc:Tr Env.Hint}" />

                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{loc:Tr Env.Add}" Command="{Binding AddEnvironmentVariableCommand}" />
                            </StackPanel>

                            <DataGrid ItemsSource="{Binding EnvironmentVariables}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Tr Env.ColName}" Width="240"
                                                        Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                                    <DataGridTextColumn Header="{loc:Tr Env.ColValue}" Width="*"
                                                        Binding="{Binding Value, UpdateSourceTrigger=LostFocus}" />
                                    <DataGridTemplateColumn Header="" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="{loc:Tr Env.Remove}" Padding="8,2" Margin="0" FontSize="11"
                                                        Style="{StaticResource DangerButton}"
                                                        Command="{Binding DataContext.SelectedApp.RemoveEnvironmentVariableCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </TabItem>

                <!-- === File cấu hình === -->
                <TabItem Header="{loc:Tr Tab.ConfigFiles}">
                    <Grid DataContext="{Binding SelectedApp}" Margin="4,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Danh sách file cấu hình -->
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0" Padding="12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Config.ListTitle}"
                                           Style="{StaticResource HeadingText}" />
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <Button Content="{loc:Tr Overview.ScanFolder}" HorizontalAlignment="Stretch"
                                            Margin="0,0,0,4"
                                            Command="{Binding DataContext.ScanConfigFolderCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                            ToolTip="{loc:Tr Config.ScanTip}" />
                                    <Button Content="{loc:Tr Config.AddManual}" Command="{Binding AddConfigFileCommand}"
                                            HorizontalAlignment="Stretch" Margin="0,0,0,4" />
                                    <Button Content="{loc:Tr Config.Remove}" Style="{StaticResource DangerButton}"
                                            Command="{Binding RemoveConfigFileCommand}"
                                            CommandParameter="{Binding SelectedConfigFile}"
                                            HorizontalAlignment="Stretch" Margin="0" />
                                </StackPanel>

                                <ListBox ItemsSource="{Binding ConfigFiles}"
                                         SelectedItem="{Binding SelectedConfigFile}"
                                         ItemContainerStyle="{StaticResource AppListItem}"
                                         Background="Transparent" BorderThickness="0"
                                         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding FormatLabel}" FontSize="11"
                                                           Foreground="{DynamicResource MutedBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Trình soạn cấu hình -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="12"
                                DataContext="{Binding SelectedConfigFile}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="{loc:Tr Config.PathLabel}" Style="{StaticResource LabelText}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding FullPath, Mode=OneWay}"
                                                 IsReadOnly="True" Foreground="{DynamicResource MutedBrush}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                            <Button Content="{loc:Tr Config.PickFile}"
                                                    Command="{Binding DataContext.BrowseConfigFileCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Content="{loc:Tr Config.OpenFolder}" Margin="0"
                                                    Command="{Binding DataContext.OpenConfigFolderCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </StackPanel>
                                    </Grid>

                                    <DockPanel Margin="0,12,0,8">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <Button Content="{loc:Tr Config.Reload}" Command="{Binding ReloadCommand}" />
                                            <Button Content="{loc:Tr Config.SaveFile}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding SaveFileCommand}" Margin="0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="{loc:Tr Config.TableMode}" GroupName="EditMode"
                                                         Margin="0,0,14,0"
                                                         IsEnabled="{Binding SupportsTable}"
                                                         IsChecked="{Binding IsRawMode, Converter={StaticResource EnumEquals},
                                                             ConverterParameter=False, Mode=OneWay}"
                                                         Checked="OnTableModeChecked" />
                                            <RadioButton Content="{loc:Tr Config.RawMode}" GroupName="EditMode"
                                                         IsChecked="{Binding IsRawMode, Mode=OneWay}"
                                                         Checked="OnRawModeChecked" />
                                        </StackPanel>
                                    </DockPanel>

                                    <Border Style="{StaticResource ErrorCard}" Margin="0,0,0,8"
                                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                                    </Border>

                                    <TextBlock Text="{Binding StatusMessage}"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               Margin="0,0,0,8"
                                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                                </StackPanel>

                                <!-- Hai chế độ nằm chồng nhau trong cùng một ô;
                                     DockPanel chỉ cho phần tử cuối chiếm hết chỗ trống,
                                     nên chúng phải được gói chung vào một Grid. -->
                                <Grid>
                                    <Grid Visibility="{Binding IsRawMode, Converter={StaticResource BoolToVisibility},
                                                               ConverterParameter=invert}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <TextBox Grid.Row="0" Margin="0,0,0,8"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{loc:Tr Config.SearchTip}" />

                                        <DataGrid Grid.Row="1" ItemsSource="{Binding EntriesView}">
                                            <DataGrid.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       Margin="4,10,0,4" />
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </DataGrid.GroupStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{loc:Tr Config.ColKey}" Width="2*"
                                                                    IsReadOnly="True" Binding="{Binding Path}" />
                                                <DataGridTextColumn Header="{loc:Tr Config.ColValue}" Width="3*"
                                                                    Binding="{Binding Value, UpdateSourceTrigger=LostFocus}" />
                                                <DataGridTextColumn Header="{loc:Tr Config.ColKind}" Width="70"
                                                                    IsReadOnly="True" Binding="{Binding KindLabel}" />
                                                <DataGridTextColumn Header="{loc:Tr Config.ColComment}" Width="*"
                                                                    IsReadOnly="True" Binding="{Binding Comment}" />
                                            </DataGrid.Columns>
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource RowDirtyBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasTypeWarning}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource RowWarningBrush}" />
                                                            <Setter Property="ToolTip" Value="{Binding TypeWarning}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                        </DataGrid>
                                    </Grid>

                                    <!-- Chế độ sửa nguồn (đặt sau để đè lên khi bật) -->
                                    <TextBox Style="{StaticResource CodeTextBox}"
                                             Text="{Binding RawText, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsRawMode, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- === Lịch chạy === -->
                <TabItem Header="{loc:Tr Tab.Schedule}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding SelectedApp}" Margin="4,0,12,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr Schedule.Card}" Style="{StaticResource HeadingText}" />

                                    <CheckBox Content="{loc:Tr Schedule.EnableCheck}"
                                              IsChecked="{Binding ScheduleEnabled}" />

                                    <TextBlock Text="{loc:Tr Schedule.KindLabel}" Style="{StaticResource LabelText}"
                                               Margin="0,12,0,4" />
                                    <StackPanel IsEnabled="{Binding ScheduleEnabled}">
                                        <RadioButton GroupName="Kind" Content="{loc:Tr Schedule.KindDaily}"
                                                     IsChecked="{Binding ScheduleKind, Converter={StaticResource EnumEquals},
                                                         ConverterParameter=DailyAtTimes}" />
                                        <RadioButton GroupName="Kind" Content="{loc:Tr Schedule.KindInterval}"
                                                     IsChecked="{Binding ScheduleKind, Converter={StaticResource EnumEquals},
                                                         ConverterParameter=Interval}" />
                                        <RadioButton GroupName="Kind" Content="{loc:Tr Schedule.KindStartup}"
                                                     IsChecked="{Binding ScheduleKind, Converter={StaticResource EnumEquals},
                                                         ConverterParameter=OnCoworkStartup}" />
                                        <RadioButton GroupName="Kind" Content="{loc:Tr Schedule.KindManual}"
                                                     IsChecked="{Binding ScheduleKind, Converter={StaticResource EnumEquals},
                                                         ConverterParameter=Manual}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}"
                                    Visibility="{Binding IsDailyKind, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr Schedule.TimesCard}" Style="{StaticResource HeadingText}" />
                                    <TextBox Text="{Binding TimesText, UpdateSourceTrigger=LostFocus}"
                                             FontFamily="Cascadia Mono, Consolas, monospace" />
                                    <TextBlock Style="{StaticResource HintText}" Text="{loc:Tr Schedule.TimesHint}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}"
                                    Visibility="{Binding IsIntervalKind, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr Schedule.IntervalCard}" Style="{StaticResource HeadingText}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:Tr Schedule.EveryMinutes}"
                                                       Style="{StaticResource LabelText}" />
                                            <TextBox Text="{Binding IntervalMinutes, UpdateSourceTrigger=LostFocus}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Tr Schedule.WindowFrom}"
                                                       Style="{StaticResource LabelText}" />
                                            <TextBox Text="{Binding WindowStart, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="{loc:Tr Schedule.WindowFromTip}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="{loc:Tr Schedule.WindowTo}"
                                                       Style="{StaticResource LabelText}" />
                                            <TextBox Text="{Binding WindowEnd, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="{loc:Tr Schedule.WindowToTip}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr Schedule.SystemCard}"
                                               Style="{StaticResource HeadingText}" />
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="{loc:Tr Schedule.SystemHint}" />

                                    <CheckBox Content="{loc:Tr Schedule.OnResume}"
                                              IsChecked="{Binding RunOnResume}" Margin="0,10,0,0" />
                                    <CheckBox Content="{loc:Tr Schedule.OnUnlock}"
                                              IsChecked="{Binding RunOnSessionUnlock}" />
                                    <CheckBox Content="{loc:Tr Schedule.OnNetwork}"
                                              IsChecked="{Binding RunOnNetworkAvailable}" />

                                    <TextBlock Text="{loc:Tr Schedule.SystemDelay}"
                                               Style="{StaticResource LabelText}" Margin="0,12,0,4" />
                                    <TextBox Text="{Binding SystemTriggerDelaySeconds, UpdateSourceTrigger=LostFocus}"
                                             Width="120" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="{loc:Tr Schedule.SystemDelayHint}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel IsEnabled="{Binding ScheduleEnabled}">
                                    <TextBlock Text="{loc:Tr Schedule.DaysCard}" Style="{StaticResource HeadingText}" />
                                    <ItemsControl ItemsSource="{Binding Days}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}"
                                                          Margin="0,0,16,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource HintText}" Text="{loc:Tr Schedule.DaysHint}" />

                                    <CheckBox Content="{loc:Tr Schedule.CatchUp}"
                                              IsChecked="{Binding CatchUpMissedRun}" Margin="0,12,0,0" />

                                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6"
                                            Padding="12" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12">
                                                <Run Text="{loc:Tr Schedule.SummaryLabel}" />
                                                <Run Text="{Binding ScheduleSummary, Mode=OneWay}"
                                                     Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                                            </TextBlock>
                                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                                       Margin="0,4,0,0">
                                                <Run Text="{loc:Tr Schedule.NextRunLabel}" />
                                                <Run Text="{Binding NextRunText, Mode=OneWay}"
                                                     Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- === Nhật ký === -->
                <TabItem Header="{loc:Tr Tab.Output}">
                    <Border Style="{StaticResource Card}" Margin="4,0,12,0" DataContext="{Binding SelectedApp}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="{loc:Tr Output.Title}" Style="{StaticResource HeadingText}"
                                           Margin="0" />
                                <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"
                                           FontSize="12">
                                    <Run Text="{Binding OutputLines.Count, Mode=OneWay}" />
                                    <Run Text="{loc:Tr Output.LinesSuffix}" />
                                </TextBlock>
                            </DockPanel>

                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource HintText}"
                                       Text="{loc:Tr Output.Hint}" />

                            <Border Background="{DynamicResource CodeBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6">
                                <ListBox x:Name="OutputList" ItemsSource="{Binding OutputLines}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         VirtualizingStackPanel.IsVirtualizing="True">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="8,1" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                                           Foreground="{DynamicResource SubtleBrush}"
                                                           FontFamily="Cascadia Mono, Consolas, monospace"
                                                           FontSize="11" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding Text}"
                                                           Style="{StaticResource OutputLineText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </DockPanel>
                    </Border>
                </TabItem>

                <!-- === Lịch sử === -->
                <TabItem Header="{loc:Tr Tab.History}">
                    <Border Style="{StaticResource Card}" Margin="4,0,12,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="{loc:Tr History.Title}" Style="{StaticResource HeadingText}"
                                           Margin="0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="{loc:Tr History.OpenLogFolder}"
                                            Command="{Binding OpenLogFolderCommand}" />
                                    <Button Content="{loc:Tr History.Clear}" Style="{StaticResource DangerButton}"
                                            Command="{Binding ClearHistoryCommand}" Margin="0" />
                                </StackPanel>
                            </DockPanel>

                            <DataGrid ItemsSource="{Binding History}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Tr History.ColStarted}" Width="150"
                                                        Binding="{Binding StartedAt, StringFormat='dd/MM/yyyy HH:mm:ss'}" />
                                    <DataGridTextColumn Header="{loc:Tr History.ColApp}" Width="*"
                                                        Binding="{Binding AppName}" />
                                    <DataGridTextColumn Header="{loc:Tr History.ColTrigger}" Width="110"
                                                        Binding="{Binding Trigger, Converter={StaticResource EnumLabel}}" />
                                    <DataGridTemplateColumn Header="{loc:Tr History.ColOutcome}" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Outcome, Converter={StaticResource EnumLabel}}"
                                                           Style="{StaticResource OutcomeText}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{loc:Tr History.ColExitCode}" Width="80"
                                                        Binding="{Binding ExitCode}" />
                                    <DataGridTextColumn Header="{loc:Tr History.ColDuration}" Width="90"
                                                        Binding="{Binding Duration, Converter={StaticResource Duration}}" />
                                    <DataGridTextColumn Header="{loc:Tr History.ColNote}" Width="2*"
                                                        Binding="{Binding Error}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </TabItem>

                <!-- === Thiết lập === -->
                <TabItem Header="{loc:Tr Tab.Settings}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,0,12,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr Settings.AppearanceCard}"
                                               Style="{StaticResource HeadingText}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:Tr Settings.ThemeLabel}"
                                                       Style="{StaticResource LabelText}" />
                                            <ComboBox ItemsSource="{Binding ThemeOptions}"
                                                      SelectedItem="{Binding SelectedTheme}"
                                                      DisplayMemberPath="Label" />
                                            <TextBlock Style="{StaticResource HintText}"
                                                       Text="{loc:Tr Settings.ThemeHint}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Tr Settings.LanguageLabel}"
                                                       Style="{StaticResource LabelText}" />
                                            <ComboBox ItemsSource="{Binding LanguageOptions}"
                                                      SelectedItem="{Binding SelectedLanguage}"
                                                      DisplayMemberPath="Label" />
                                            <TextBlock Style="{StaticResource HintText}"
                                                       Text="{loc:Tr Settings.LanguageHint}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr Settings.BackgroundCard}"
                                               Style="{StaticResource HeadingText}" />
                                    <CheckBox Content="{loc:Tr Settings.SchedulerCheck}"
                                              IsChecked="{Binding SchedulerEnabled}" />
                                    <CheckBox Content="{loc:Tr Settings.MinimizeCheck}"
                                              IsChecked="{Binding MinimizeToTray}" />
                                    <CheckBox Content="{loc:Tr Settings.StartupCheck}"
                                              IsChecked="{Binding StartWithWindows}" />
                                    <CheckBox Content="{loc:Tr Settings.NotifyCheck}"
                                              IsChecked="{Binding NotifyOnFailure}" />
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="{loc:Tr Settings.BackgroundHint}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr Settings.HistoryCard}"
                                               Style="{StaticResource HeadingText}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:Tr Settings.RetentionLabel}"
                                                       Style="{StaticResource LabelText}" />
                                            <TextBox Text="{Binding HistoryRetentionDays, UpdateSourceTrigger=LostFocus}"
                                                     Width="120" HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Tr Settings.LogRetentionLabel}"
                                                       Style="{StaticResource LabelText}" />
                                            <TextBox Text="{Binding LogRetentionDays, UpdateSourceTrigger=LostFocus}"
                                                     Width="120" HorizontalAlignment="Left" />
                                            <TextBlock Style="{StaticResource HintText}"
                                                       Text="{loc:Tr Settings.LogRetentionHint}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="{loc:Tr Settings.OpenDataFolder}"
                                                Command="{Binding OpenDataFolderCommand}" />
                                        <Button Content="{loc:Tr Settings.OpenLogFolder}"
                                                Command="{Binding OpenLogFolderCommand}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="{loc:Tr Settings.DataHint}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr Settings.RemoteCard}"
                                               Style="{StaticResource HeadingText}" />
                                    <TextBlock Text="{loc:Tr Settings.HubUrl}" Style="{StaticResource LabelText}" />
                                    <TextBox Text="{Binding HubUrl, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="https://hub.example.com" />
                                    <TextBlock Text="{loc:Tr Settings.HubToken}" Style="{StaticResource LabelText}"
                                               Margin="0,12,0,4" />
                                    <TextBox Text="{Binding HubToken, UpdateSourceTrigger=LostFocus}"
                                             FontFamily="Cascadia Mono, Consolas, monospace" />
                                    <DockPanel Margin="0,12,0,0">
                                        <Button DockPanel.Dock="Right" Content="{loc:Tr Settings.HubReconnect}"
                                                Command="{Binding ReconnectHubCommand}" Margin="0" />
                                        <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12">
                                            <Run Text="{loc:Tr Settings.HubStatus}" />
                                            <Run Text="{Binding HubStatusText, Mode=OneWay}"
                                                 Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                                        </TextBlock>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="{loc:Tr Settings.HubHint}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- === Thanh trạng thái === -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource WarningBrush}" FontSize="12"
                           Text="{loc:Tr Status.Unsaved}"
                           Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- === Khay hệ thống === -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="Assets/cowork.ico"
                        ToolTipText="{loc:Tr Tray.Tooltip}"
                        TrayMouseDoubleClick="OnTrayDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{loc:Tr Tray.Open}" Click="OnTrayOpenClick" />
                    <Separator />
                    <MenuItem Header="{loc:Tr Main.RunAll}" Command="{Binding RunAllCommand}" />
                    <MenuItem Header="{loc:Tr Main.StopAll}" Command="{Binding StopAllCommand}" />
                    <Separator />
                    <MenuItem Header="{loc:Tr Tray.Exit}" Click="OnTrayExitClick" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveWorkspaceCommand}" />
        <KeyBinding Key="F5" Command="{Binding RunSelectedCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddAppCommand}" />
    </Window.InputBindings>
</Window>
