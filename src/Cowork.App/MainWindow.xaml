<Window x:Class="Cowork.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="Cowork — Quản lý app chạy hằng ngày"
        Height="820" Width="1320" MinHeight="620" MinWidth="1060"
        Icon="Assets/cowork.ico"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI" FontSize="13"
        Closing="OnWindowClosing" StateChanged="OnWindowStateChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- === Thanh công cụ === -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Cowork" FontSize="17" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" Margin="0,0,20,0" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox Content="Chạy theo lịch" IsChecked="{Binding SchedulerEnabled}"
                              Margin="0,0,14,0"
                              ToolTip="Bật/tắt bộ đếm nền tự động chạy app theo lịch đã đặt" />
                    <Button Content="Lưu" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveWorkspaceCommand}" Margin="0" MinWidth="72"
                            ToolTip="Lưu danh sách app và thiết lập (Ctrl+S)" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Content="▶  Chạy" Style="{StaticResource PrimaryButton}"
                            Command="{Binding RunSelectedCommand}" ToolTip="Chạy app đang chọn (F5)" />
                    <Button Content="■  Dừng" Command="{Binding StopSelectedCommand}"
                            ToolTip="Dừng app đang chọn" />
                    <Border Width="1" Margin="6,4" Background="{StaticResource BorderBrush}" />
                    <Button Content="Chạy tất cả" Command="{Binding RunAllCommand}"
                            ToolTip="Chạy lần lượt mọi app đang bật" />
                    <Button Content="Dừng tất cả" Command="{Binding StopAllCommand}" />
                    <Button Content="Kiểm tra lịch" Command="{Binding CheckScheduleNowCommand}"
                            ToolTip="Chạy ngay một vòng kiểm tra lịch thay vì chờ tới tick sau" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- === Nội dung === -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="520" />
            </Grid.ColumnDefinitions>

            <!-- Cột trái: danh sách app -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Danh sách app" Style="{StaticResource HeadingText}" />

                    <TextBox DockPanel.Dock="Top" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,8" ToolTip="Lọc theo tên, nhóm hoặc đường dẫn" />

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="+ Thêm" Command="{Binding AddAppCommand}" Padding="10,5" />
                        <Button Content="Nhân bản" Command="{Binding DuplicateAppCommand}" Padding="10,5" />
                        <Button Content="Xoá" Command="{Binding DeleteAppCommand}"
                                Style="{StaticResource DangerButton}" Padding="10,5" />
                        <Button Content="↑" Command="{Binding MoveUpCommand}" Padding="8,5" MinWidth="30"
                                ToolTip="Đưa lên trên (ảnh hưởng thứ tự Chạy tất cả)" />
                        <Button Content="↓" Command="{Binding MoveDownCommand}" Padding="8,5" MinWidth="30"
                                Margin="0" ToolTip="Đưa xuống dưới" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding AppsView}" SelectedItem="{Binding SelectedApp}"
                             ItemContainerStyle="{StaticResource AppListItem}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,0,10,0"
                                             VerticalAlignment="Top"
                                             Fill="{Binding RuntimeState, Converter={StaticResource StateToBrush}}"
                                             ToolTip="{Binding StatusText}" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="Kế tiếp:" />
                                            <Run Text="{Binding NextRunText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="⏸" FontSize="12" VerticalAlignment="Top"
                                               Foreground="{StaticResource MutedBrush}"
                                               ToolTip="App đang tắt, sẽ không chạy"
                                               Visibility="{Binding IsEnabled,
                                                   Converter={StaticResource BoolToVisibility},
                                                   ConverterParameter=invert}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                          Background="Transparent" />

            <!-- Cột phải: chi tiết -->
            <TabControl Grid.Column="2">

                <!-- === Tổng quan === -->
                <TabItem Header="Tổng quan">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,0,12,0">
                            <TextBlock Text="Chưa chọn app nào. Bấm '+ Thêm' để tạo app đầu tiên."
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="Margin" Value="0,20" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedApp}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel DataContext="{Binding SelectedApp}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Thông tin app" Style="{StaticResource HeadingText}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Tên app" Style="{StaticResource LabelText}" />
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Nhóm" Style="{StaticResource LabelText}" />
                                                <TextBox Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Ví dụ: Backup, Báo cáo sáng, Dịch vụ nền" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Mô tả" Style="{StaticResource LabelText}" Margin="0,12,0,4" />
                                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" MinHeight="52" TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top" />

                                        <CheckBox Content="Bật app này (bỏ chọn thì không chạy tay lẫn theo lịch)"
                                                  IsChecked="{Binding IsEnabled}" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Lệnh chạy" Style="{StaticResource HeadingText}" />

                                        <TextBlock Text="Chương trình (.exe / .bat / .cmd / .ps1)"
                                                   Style="{StaticResource LabelText}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                                <Button Content="Chọn…"
                                                        Command="{Binding DataContext.BrowseExecutableCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                        ToolTip="Chỉ đích danh một file" />
                                                <Button Content="Quét thư mục…" Margin="0"
                                                        Command="{Binding DataContext.ScanProgramFolderCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                        ToolTip="Dò tìm .exe/.bat/.cmd/.ps1 trong một thư mục" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Tham số dòng lệnh" Style="{StaticResource LabelText}"
                                                   Margin="0,12,0,4" />
                                        <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Cascadia Mono, Consolas, monospace" />
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="Hỗ trợ biến môi trường dạng %USERPROFILE%. Đường dẫn có dấu cách nhớ bọc trong nháy kép." />

                                        <TextBlock Text="Thư mục làm việc" Style="{StaticResource LabelText}"
                                                   Margin="0,12,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="1" Content="Chọn…" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.BrowseWorkingDirectoryCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="Để trống thì Cowork dùng thư mục chứa file chương trình." />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Tuỳ chọn khi chạy" Style="{StaticResource HeadingText}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <CheckBox Content="Không chạy chồng (chặn nếu instance cũ còn sống)"
                                                          IsChecked="{Binding SingleInstance}" />
                                                <CheckBox Content="Thu nhật ký output vào Cowork"
                                                          IsChecked="{Binding CaptureOutput}" />
                                                <CheckBox Content="Chạy với quyền quản trị (UAC)"
                                                          IsChecked="{Binding RunAsAdministrator}"
                                                          ToolTip="Bật cái này thì không thu được output" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Kiểu cửa sổ" Style="{StaticResource LabelText}" />
                                                <ComboBox ItemsSource="{Binding WindowStyleOptions}"
                                                          SelectedItem="{Binding WindowStyle}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBlock Text="Tự dừng sau (phút, 0 = không giới hạn)"
                                                           Style="{StaticResource LabelText}" Margin="0,12,0,4" />
                                                <TextBox Text="{Binding TimeoutMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Tình trạng" Style="{StaticResource HeadingText}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Trạng thái:"
                                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,10,4" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusText}" Margin="0,0,0,4" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Chạy lần cuối:"
                                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,10,4" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastRunText}" Margin="0,0,0,4" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Lịch:"
                                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ScheduleSummary}" />
                                        </Grid>

                                        <Border Background="#3A1D22" BorderBrush="{StaticResource DangerBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,12,0,0"
                                                Visibility="{Binding LastError, Converter={StaticResource StringToVisibility}}">
                                            <TextBlock Text="{Binding LastError}" TextWrapping="Wrap"
                                                       Foreground="#FFB4B7" />
                                        </Border>

                                        <Button Content="Mở thư mục chứa app" Margin="0,12,0,0"
                                                HorizontalAlignment="Left"
                                                Command="{Binding DataContext.OpenAppFolderCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- === Biến môi trường === -->
                <TabItem Header="Biến môi trường">
                    <Border Style="{StaticResource Card}" DataContext="{Binding SelectedApp}" Margin="4,0,12,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Biến môi trường riêng của app"
                                       Style="{StaticResource HeadingText}" />
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource HintText}" Margin="0,0,0,10"
                                       Text="Các biến này chỉ áp dụng cho tiến trình con do Cowork khởi chạy, không ảnh hưởng hệ thống. Giá trị hỗ trợ %BIEN_KHAC%." />

                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="+ Thêm biến" Command="{Binding AddEnvironmentVariableCommand}" />
                            </StackPanel>

                            <DataGrid ItemsSource="{Binding EnvironmentVariables}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tên biến" Width="240"
                                                        Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                                    <DataGridTextColumn Header="Giá trị" Width="*"
                                                        Binding="{Binding Value, UpdateSourceTrigger=LostFocus}" />
                                    <DataGridTemplateColumn Header="" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Xoá" Padding="8,2" Margin="0" FontSize="11"
                                                        Style="{StaticResource DangerButton}"
                                                        Command="{Binding DataContext.SelectedApp.RemoveEnvironmentVariableCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </TabItem>

                <!-- === File cấu hình === -->
                <TabItem Header="File cấu hình">
                    <Grid DataContext="{Binding SelectedApp}" Margin="4,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Danh sách file cấu hình -->
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0" Padding="12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="File cấu hình"
                                           Style="{StaticResource HeadingText}" />
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <Button Content="Quét thư mục…" HorizontalAlignment="Stretch"
                                            Margin="0,0,0,4"
                                            Command="{Binding DataContext.ScanConfigFolderCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                            ToolTip="Tự dò tìm file cấu hình trong thư mục làm việc của app" />
                                    <Button Content="+ Thêm file thủ công" Command="{Binding AddConfigFileCommand}"
                                            HorizontalAlignment="Stretch" Margin="0,0,0,4" />
                                    <Button Content="Bỏ file khỏi danh sách" Style="{StaticResource DangerButton}"
                                            Command="{Binding RemoveConfigFileCommand}"
                                            CommandParameter="{Binding SelectedConfigFile}"
                                            HorizontalAlignment="Stretch" Margin="0" />
                                </StackPanel>

                                <ListBox ItemsSource="{Binding ConfigFiles}"
                                         SelectedItem="{Binding SelectedConfigFile}"
                                         ItemContainerStyle="{StaticResource AppListItem}"
                                         Background="Transparent" BorderThickness="0"
                                         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding FormatLabel}" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Trình soạn cấu hình -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="12"
                                DataContext="{Binding SelectedConfigFile}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="Đường dẫn file" Style="{StaticResource LabelText}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding FullPath, Mode=OneWay}"
                                                 IsReadOnly="True" Foreground="{StaticResource MutedBrush}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                            <Button Content="Chọn file…"
                                                    Command="{Binding DataContext.BrowseConfigFileCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Content="Mở thư mục" Margin="0"
                                                    Command="{Binding DataContext.OpenConfigFolderCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </StackPanel>
                                    </Grid>

                                    <DockPanel Margin="0,12,0,8">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <Button Content="Tải lại" Command="{Binding ReloadCommand}" />
                                            <Button Content="Lưu file" Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding SaveFileCommand}" Margin="0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="Dạng bảng" GroupName="EditMode" Margin="0,0,14,0"
                                                         IsEnabled="{Binding SupportsTable}"
                                                         IsChecked="{Binding IsRawMode, Converter={StaticResource EnumEquals},
                                                             ConverterParameter=False, Mode=OneWay}"
                                                         Checked="OnTableModeChecked" />
                                            <RadioButton Content="Sửa nguồn" GroupName="EditMode"
                                                         IsChecked="{Binding IsRawMode, Mode=OneWay}"
                                                         Checked="OnRawModeChecked" />
                                        </StackPanel>
                                    </DockPanel>

                                    <Border Background="#3A1D22" BorderBrush="{StaticResource DangerBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8"
                                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                                                   Foreground="#FFB4B7" />
                                    </Border>

                                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                                               Margin="0,0,0,8"
                                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                                </StackPanel>

                                <!-- Hai chế độ nằm chồng nhau trong cùng một ô;
                                     DockPanel chỉ cho phần tử cuối chiếm hết chỗ trống,
                                     nên chúng phải được gói chung vào một Grid. -->
                                <Grid>
                                <Grid Visibility="{Binding IsRawMode, Converter={StaticResource BoolToVisibility},
                                                           ConverterParameter=invert}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBox Grid.Row="0" Margin="0,0,0,8"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Lọc theo tên khoá hoặc giá trị" />

                                    <DataGrid Grid.Row="1" ItemsSource="{Binding EntriesView}">
                                        <DataGrid.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   Margin="4,10,0,4" />
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </DataGrid.GroupStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Khoá" Width="2*" IsReadOnly="True"
                                                                Binding="{Binding Path}" />
                                            <DataGridTextColumn Header="Giá trị" Width="3*"
                                                                Binding="{Binding Value, UpdateSourceTrigger=LostFocus}" />
                                            <DataGridTextColumn Header="Kiểu" Width="70" IsReadOnly="True"
                                                                Binding="{Binding KindLabel}" />
                                            <DataGridTextColumn Header="Ghi chú" Width="*" IsReadOnly="True"
                                                                Binding="{Binding Comment}" />
                                        </DataGrid.Columns>
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                        <Setter Property="Background" Value="#243C2E" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasTypeWarning}" Value="True">
                                                        <Setter Property="Background" Value="#3A2A1D" />
                                                        <Setter Property="ToolTip" Value="{Binding TypeWarning}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                    </DataGrid>
                                </Grid>

                                <!-- Chế độ sửa nguồn (đặt sau để đè lên khi bật) -->
                                <TextBox Style="{StaticResource CodeTextBox}"
                                         Text="{Binding RawText, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding IsRawMode, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- === Lịch chạy === -->
                <TabItem Header="Lịch chạy">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding SelectedApp}" Margin="4,0,12,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Lịch chạy hằng ngày" Style="{StaticResource HeadingText}" />

                                    <CheckBox Content="Bật lịch tự động cho app này"
                                              IsChecked="{Binding ScheduleEnabled}" />

                                    <TextBlock Text="Kiểu lịch" Style="{StaticResource LabelText}" Margin="0,12,0,4" />
                                    <StackPanel IsEnabled="{Binding ScheduleEnabled}">
                                        <RadioButton GroupName="Kind" Content="Chạy vào các mốc giờ cố định"
                                                     IsChecked="{Binding ScheduleKind, Converter={StaticResource EnumEquals},
                                                         ConverterParameter=DailyAtTimes}" />
                                        <RadioButton GroupName="Kind" Content="Chạy lặp lại theo chu kỳ"
                                                     IsChecked="{Binding ScheduleKind, Converter={StaticResource EnumEquals},
                                                         ConverterParameter=Interval}" />
                                        <RadioButton GroupName="Kind" Content="Chạy một lần khi mở Cowork"
                                                     IsChecked="{Binding ScheduleKind, Converter={StaticResource EnumEquals},
                                                         ConverterParameter=OnCoworkStartup}" />
                                        <RadioButton GroupName="Kind" Content="Chỉ chạy thủ công"
                                                     IsChecked="{Binding ScheduleKind, Converter={StaticResource EnumEquals},
                                                         ConverterParameter=Manual}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}"
                                    Visibility="{Binding IsDailyKind, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Mốc giờ trong ngày" Style="{StaticResource HeadingText}" />
                                    <TextBox Text="{Binding TimesText, UpdateSourceTrigger=LostFocus}"
                                             FontFamily="Cascadia Mono, Consolas, monospace" />
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="Nhập nhiều mốc, cách nhau bằng dấu phẩy. Ví dụ: 07:30, 12:00, 18:15" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}"
                                    Visibility="{Binding IsIntervalKind, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Chu kỳ lặp" Style="{StaticResource HeadingText}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Mỗi (phút)" Style="{StaticResource LabelText}" />
                                            <TextBox Text="{Binding IntervalMinutes, UpdateSourceTrigger=LostFocus}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Chỉ chạy từ" Style="{StaticResource LabelText}" />
                                            <TextBox Text="{Binding WindowStart, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="Bỏ trống nếu không giới hạn. Ví dụ 08:00" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Đến" Style="{StaticResource LabelText}" />
                                            <TextBox Text="{Binding WindowEnd, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="Bỏ trống nếu không giới hạn. Ví dụ 18:00" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel IsEnabled="{Binding ScheduleEnabled}">
                                    <TextBlock Text="Ngày trong tuần" Style="{StaticResource HeadingText}" />
                                    <ItemsControl ItemsSource="{Binding Days}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}"
                                                          Margin="0,0,16,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="Không chọn ngày nào = chạy mọi ngày trong tuần." />

                                    <CheckBox Content="Chạy bù nếu lúc tới hạn máy đang tắt hoặc Cowork chưa mở"
                                              IsChecked="{Binding CatchUpMissedRun}" Margin="0,12,0,0" />

                                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6"
                                            Padding="12" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12">
                                                <Run Text="Tóm tắt:" />
                                                <Run Text="{Binding ScheduleSummary, Mode=OneWay}"
                                                     Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                            </TextBlock>
                                            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0">
                                                <Run Text="Lần chạy kế tiếp:" />
                                                <Run Text="{Binding NextRunText, Mode=OneWay}"
                                                     Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- === Nhật ký === -->
                <TabItem Header="Nhật ký">
                    <Border Style="{StaticResource Card}" Margin="4,0,12,0" DataContext="{Binding SelectedApp}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="Output của lần chạy hiện tại" Style="{StaticResource HeadingText}"
                                           Margin="0" />
                                <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"
                                           FontSize="12">
                                    <Run Text="{Binding OutputLines.Count, Mode=OneWay}" />
                                    <Run Text="dòng" />
                                </TextBlock>
                            </DockPanel>

                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource HintText}"
                                       Text="Output chỉ được thu khi bật 'Thu nhật ký output' và không chạy quyền admin. Log đầy đủ nằm trong thư mục logs." />

                            <Border Background="#0D1117" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6">
                                <ListBox x:Name="OutputList" ItemsSource="{Binding OutputLines}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         VirtualizingStackPanel.IsVirtualizing="True">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="8,1" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontFamily="Cascadia Mono, Consolas, monospace"
                                                           FontSize="11" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding Text}"
                                                           Foreground="{Binding IsError, Converter={StaticResource OutputBrush}}"
                                                           FontFamily="Cascadia Mono, Consolas, monospace"
                                                           FontSize="12" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </DockPanel>
                    </Border>
                </TabItem>

                <!-- === Lịch sử === -->
                <TabItem Header="Lịch sử chạy">
                    <Border Style="{StaticResource Card}" Margin="4,0,12,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="Lịch sử các lần chạy" Style="{StaticResource HeadingText}" Margin="0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Mở thư mục log" Command="{Binding OpenLogFolderCommand}" />
                                    <Button Content="Xoá lịch sử" Style="{StaticResource DangerButton}"
                                            Command="{Binding ClearHistoryCommand}" Margin="0" />
                                </StackPanel>
                            </DockPanel>

                            <DataGrid ItemsSource="{Binding History}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Bắt đầu" Width="150"
                                                        Binding="{Binding StartedAt, StringFormat='dd/MM/yyyy HH:mm:ss'}" />
                                    <DataGridTextColumn Header="App" Width="*" Binding="{Binding AppName}" />
                                    <DataGridTextColumn Header="Nguồn" Width="110"
                                                        Binding="{Binding Trigger, Converter={StaticResource EnumLabel}}" />
                                    <DataGridTemplateColumn Header="Kết quả" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Outcome, Converter={StaticResource EnumLabel}}"
                                                           Foreground="{Binding Outcome, Converter={StaticResource OutcomeBrush}}"
                                                           FontWeight="SemiBold" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Mã thoát" Width="80" Binding="{Binding ExitCode}" />
                                    <DataGridTextColumn Header="Thời lượng" Width="90"
                                                        Binding="{Binding Duration, Converter={StaticResource Duration}}" />
                                    <DataGridTextColumn Header="Ghi chú" Width="2*" Binding="{Binding Error}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </TabItem>

                <!-- === Thiết lập === -->
                <TabItem Header="Thiết lập">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,0,12,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Chạy nền" Style="{StaticResource HeadingText}" />
                                    <CheckBox Content="Bật bộ lập lịch (tự chạy app theo giờ đã đặt)"
                                              IsChecked="{Binding SchedulerEnabled}" />
                                    <CheckBox Content="Bấm X thì thu nhỏ xuống khay hệ thống thay vì thoát"
                                              IsChecked="{Binding MinimizeToTray}" />
                                    <CheckBox Content="Khởi động cùng Windows (mở ở chế độ thu nhỏ)"
                                              IsChecked="{Binding StartWithWindows}" />
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="Bộ lập lịch chỉ hoạt động khi Cowork còn đang chạy — kể cả khi đã thu nhỏ xuống khay." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Lịch sử &amp; nhật ký" Style="{StaticResource HeadingText}" />
                                    <TextBlock Text="Số ngày giữ lịch sử chạy" Style="{StaticResource LabelText}" />
                                    <TextBox Text="{Binding HistoryRetentionDays, UpdateSourceTrigger=LostFocus}"
                                             Width="120" HorizontalAlignment="Left" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Mở thư mục dữ liệu" Command="{Binding OpenDataFolderCommand}" />
                                        <Button Content="Mở thư mục log" Command="{Binding OpenLogFolderCommand}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="Dữ liệu Cowork nằm trong %APPDATA%\Cowork — sao lưu workspace.json là sao lưu được toàn bộ cấu hình app." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- === Thanh trạng thái === -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource WarningBrush}" FontSize="12"
                           Text="● Có thay đổi chưa lưu"
                           Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- === Khay hệ thống === -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="Assets/cowork.ico"
                        ToolTipText="Cowork — quản lý app chạy hằng ngày"
                        TrayMouseDoubleClick="OnTrayDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Mở Cowork" Click="OnTrayOpenClick" />
                    <Separator />
                    <MenuItem Header="Chạy tất cả" Command="{Binding RunAllCommand}" />
                    <MenuItem Header="Dừng tất cả" Command="{Binding StopAllCommand}" />
                    <Separator />
                    <MenuItem Header="Thoát Cowork" Click="OnTrayExitClick" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveWorkspaceCommand}" />
        <KeyBinding Key="F5" Command="{Binding RunSelectedCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddAppCommand}" />
    </Window.InputBindings>
</Window>
