<Application x:Class="Cowork.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Cowork.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
            <conv:RuntimeStateToBrushConverter x:Key="StateToBrush" />
            <conv:OutputErrorToBrushConverter x:Key="OutputBrush" />
            <conv:RunOutcomeToBrushConverter x:Key="OutcomeBrush" />
            <conv:EnumLabelConverter x:Key="EnumLabel" />
            <conv:EnumEqualsConverter x:Key="EnumEquals" />
            <conv:DurationConverter x:Key="Duration" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
