<Application x:Class="Cowork.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Cowork.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Ô số 0 là bảng màu: ThemeManager tráo đúng phần tử này khi đổi chủ đề,
                     nên nó phải luôn đứng đầu và Theme.xaml phải đứng sau. -->
                <ResourceDictionary Source="Themes/Palettes/Dark.xaml" />
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
            <conv:EnumLabelConverter x:Key="EnumLabel" />
            <conv:EnumEqualsConverter x:Key="EnumEquals" />
            <conv:DurationConverter x:Key="Duration" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
