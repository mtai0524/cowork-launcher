<!--
    Chủ đề Tối — mặc định của Cowork.

    Mọi bảng màu phải khai báo đủ bộ khoá này: Theme.xaml tra cứu bằng DynamicResource
    nên thiếu một khoá là mất màu ở đúng chỗ đó, không có lỗi build nào báo trước.
    Tương phản chữ/nền được kiểm bằng ThemeContrastTests.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Nền và bề mặt ===== -->
    <Color x:Key="WindowBackgroundColor">#12161C</Color>
    <Color x:Key="SurfaceColor">#1A2029</Color>
    <Color x:Key="SurfaceAltColor">#232C39</Color>
    <Color x:Key="SurfaceHoverColor">#2C3746</Color>
    <Color x:Key="SurfacePressedColor">#3A4759</Color>
    <Color x:Key="SelectionColor">#27384F</Color>
    <Color x:Key="AlternatingRowColor">#1E252F</Color>
    <Color x:Key="CodeBackgroundColor">#0D1117</Color>

    <!-- ===== Đường kẻ ===== -->
    <Color x:Key="BorderColor">#3A4759</Color>
    <Color x:Key="DividerColor">#2A3441</Color>

    <!-- ===== Chữ ===== -->
    <Color x:Key="TextColor">#EAEFF7</Color>
    <Color x:Key="MutedColor">#AFBBCB</Color>
    <Color x:Key="SubtleColor">#9AA7B9</Color>

    <!-- ===== Nhấn ===== -->
    <Color x:Key="AccentColor">#5CA0FF</Color>
    <Color x:Key="AccentFillColor">#2A64D2</Color>
    <Color x:Key="AccentFillHoverColor">#3070E2</Color>
    <Color x:Key="AccentFillPressedColor">#21529F</Color>
    <Color x:Key="OnAccentColor">#FFFFFF</Color>

    <!-- ===== Ngữ nghĩa ===== -->
    <Color x:Key="SuccessColor">#4ADE9B</Color>
    <Color x:Key="WarningColor">#F5C33B</Color>
    <Color x:Key="DangerColor">#FF8086</Color>
    <Color x:Key="SuccessSurfaceColor">#173328</Color>
    <Color x:Key="WarningSurfaceColor">#3A2E19</Color>
    <Color x:Key="DangerSurfaceColor">#3A1D22</Color>
    <Color x:Key="StateIdleColor">#9AA7B9</Color>

    <!-- ===== Thanh cuộn ===== -->
    <Color x:Key="ScrollBarTrackColor">#161C24</Color>
    <Color x:Key="ScrollBarThumbColor">#3A4759</Color>
    <Color x:Key="ScrollBarThumbHoverColor">#4B5A70</Color>

    <!-- ===== Chổi màu ===== -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
    <SolidColorBrush x:Key="AlternatingRowBrush" Color="{StaticResource AlternatingRowColor}" />
    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="{StaticResource CodeBackgroundColor}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />

    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource SubtleColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentFillBrush" Color="{StaticResource AccentFillColor}" />
    <SolidColorBrush x:Key="AccentFillHoverBrush" Color="{StaticResource AccentFillHoverColor}" />
    <SolidColorBrush x:Key="AccentFillPressedBrush" Color="{StaticResource AccentFillPressedColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="{StaticResource SuccessSurfaceColor}" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="{StaticResource WarningSurfaceColor}" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="{StaticResource DangerSurfaceColor}" />

    <!-- Bí danh ngữ nghĩa: view chỉ nói "đang chạy", không nói "màu xanh lá". -->
    <SolidColorBrush x:Key="StateIdleBrush" Color="{StaticResource StateIdleColor}" />
    <SolidColorBrush x:Key="StateRunningBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="StateStartingBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="StateFailedBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="OutputTextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="OutputErrorBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="RowDirtyBrush" Color="{StaticResource SuccessSurfaceColor}" />
    <SolidColorBrush x:Key="RowWarningBrush" Color="{StaticResource WarningSurfaceColor}" />
    <SolidColorBrush x:Key="ChipHighBrush" Color="{StaticResource SuccessSurfaceColor}" />
    <SolidColorBrush x:Key="ChipMediumBrush" Color="{StaticResource WarningSurfaceColor}" />
    <SolidColorBrush x:Key="ChipLowBrush" Color="{StaticResource SurfaceHoverColor}" />

    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{StaticResource ScrollBarTrackColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{StaticResource ScrollBarThumbColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{StaticResource ScrollBarThumbHoverColor}" />

</ResourceDictionary>
